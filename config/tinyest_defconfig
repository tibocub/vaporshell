# The smallest binary: a POSIX (dash-like) script runner. No bash extensions, no line editor,
# history or completion (an interactive session reads plain lines from the terminal), no
# title, no hardening flags.
CONFIG_VASH_OPT_SIZE=y
CONFIG_VASH_GC_SECTIONS=y
CONFIG_VASH_LTO=y
CONFIG_VASH_STRIP=y
# CONFIG_VASH_HARDEN is not set
CONFIG_VASH_MODES_POSIX_ONLY=y
# CONFIG_VASH_LINE_EDITOR is not set
