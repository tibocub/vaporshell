config VAPOROS_VAPORSHELL
	tristate "vaporshell -- vaporOS's own shell"
	default n
	---help---
		A POSIX-first shell: parser + AST executor, all POSIX expansions,
		redirections, functions, traps and a table of builtins. See
		docs/design.md. Runs as an ordinary NSH builtin for now
		(nsh> vaporshell) -- not wired in as any board's boot entrypoint yet.

if VAPOROS_VAPORSHELL

config VAPOROS_VAPORSHELL_PROGNAME
	string "Program name"
	default "vaporshell"

config VAPOROS_VAPORSHELL_PRIORITY
	int "priority"
	default 100

config VAPOROS_VAPORSHELL_STACKSIZE
	int "stack size"
	default DEFAULT_TASK_STACKSIZE

endif
