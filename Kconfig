config VAPOROS_VAPORSHELL
	tristate "vaporshell -- vaporOS's own shell"
	default n
	---help---
		docs/vaporshell.md Milestone 1: runs programs via posix_spawnp
		(PATH resolution), a cd builtin, exit-status tracking, and a
		-c mode for non-interactive single commands (the same argv
		shape apps/system/system/system.c uses when
		CONFIG_SYSTEM_SYSTEM_SHPATH points elsewhere than NSH). No
		pipes, redirection, expansion, or control flow yet -- see the
		design doc for what's deliberately deferred and why. Runs as
		an ordinary NSH builtin for now (nsh> vaporshell) -- not wired
		in as any board's boot entrypoint yet.

if VAPOROS_VAPORSHELL

config VAPOROS_VAPORSHELL_PROGNAME
	string "Program name"
	default "vaporshell"

config VAPOROS_VAPORSHELL_PRIORITY
	int "priority"
	default 100

config VAPOROS_VAPORSHELL_STACKSIZE
	int "stack size"
	default DEFAULT_TASK_STACKSIZE

endif
